# Optional NexAU delivery backend; export these before running the CLI.
# This is an Anthropic-compatible Messages base URL, not /chat/completions.
OPENAGENTS_NEXAU_MODEL=your-model
OPENAGENTS_NEXAU_BASE_URL=https://messages.example
OPENAGENTS_NEXAU_API_KEY=replace-locally
OPENAGENTS_NEXAU_MAX_CONTEXT_TOKENS=262144
OPENAGENTS_NEXAU_MAX_OUTPUT_TOKENS=32768
GITEA_TOKEN=replace-locally
