# OpenAgents configuration (Spec-0064 / Spec-0067)
#
# openagents init writes this template. Edit it directly, or run
# openagents init --force to reset it. An absent or empty file uses the built-in
# defaults. Omitted keys use their defaults. Command-line options such as
# openagents vigil --skip ci and --base override configuration for one run.
# The loader and validation rules live in openagents/utils/agent_config.py.

version: 1

# Delivery flow:
#   standard      Default Spec-driven delivery.
#   minimal       Compact Spec, one implementation, acceptance against the original issue.
#   generate-only Compact Spec, constrained executor, mechanical merge without quality checks.
#   v0.2          Batch Specs, post-Spec dependency graph, Developer, Acceptance, mechanical merge.
# flow: minimal

# Vigil admission coordination (Spec-0091):
#   dependencies  Default; the Curator proposes blocking dependencies.
#   soft          Nonblocking advice within 90 seconds; preserve issue objectives and acceptance.
#   off           No coordination model or new edges; existing forge dependencies still apply.
# coordination: soft

# GitHub uses the gh CLI and is the default. Gitea uses REST with a token from
# the environment. Set the sibling gitea mapping when selecting forge: gitea.
# forge: gitea
# gitea:
#   base_url: http://localhost:3000
#   owner: your-org
#   repo: your-repo
#   token_env: GITEA_TOKEN   # Optional; OpenAgents does not store the token itself.

# Require execution contracts only if negotiated with the publisher (Spec-0093).
# Missing or invalid evidence pauses delivery. Only trusted project configuration
# can set this option; issue text cannot turn it off. Defaults to false.
# execution_evidence:
#   required: true

# Per-role backend declarations default to claude_code. The current CLI
# selects the backend globally using OPENAGENTS_BACKEND.
agents:
  architect:   { backend: claude_code }
  spec_writer: { backend: claude_code }
  spec_curator: { backend: claude_code }
  implementer: { backend: claude_code }
  developer:   { backend: claude_code }
  acceptance:  { backend: claude_code }
  executor:    { backend: claude_code }
  reviewer:    { backend: claude_code }

# agent enables a stage; skip treats it as passed where allowed.
stages:
  triage:   agent      # Issue admission: agent or skip.
  rfc:      agent      # Spec drafting: agent or skip. Skipping emits a warning.
  architecture: agent  # Architecture review: skip only with rfc: skip.
  conflict: agent      # Conflict resolution cannot be skipped.
  ci:       agent      # Wait for successful CI: agent or skip.
  e2e:      agent      # End-to-end evidence: agent or skip.
  review:   agent      # Code review must stay enabled with automatic merge.
  merge:    agent      # Merge cannot be skipped.

# manual requires an explicit release command. auto parses but is not implemented.
release: manual

# Repository settings can override these defaults.
defaults:
  interval: 60         # Vigil poll interval, in seconds.
  base: main           # Target branch.
  labels: [openagents] # Issue discovery labels.

# Each repository uses a separate process for its gh/git working directory.
# Omit repos to watch only the current directory.
repos:
  - path: .
    # Optional overrides: name, base, interval, labels, and stages.
    # stages:
    #   e2e: skip

# The head-advanced, evidence-stamp, and round-cap checks are deterministic and
# cannot be configured here. Implement and deliver always invoke an agent.
# Skipping ci treats CI as successful. Skipping e2e stamps the current head.
