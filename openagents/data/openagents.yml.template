# OpenAgents 声明式配置 (Spec-0064 / Spec-0067)
# ============================================================================
# 本文件由 `openagents init` 从包内模板自动生成(Spec-0067)。直接按需删改即可；
# 想用包内最新模板重置，跑 `openagents init --force`。
#
# 「用哪些 agent + 每道闸归谁把关」的单一真源。
# 整份可省——文件不存在或为空则全回落内建默认(全自动、全 agent、单仓、间隔 60s)，
# 不写 YAML 的用户零感知。下面每个键都可删；删掉即用内建默认。
# 生成物只是声明式默认——运行时 `openagents vigil --skip ci` / `--base` 仍可单次覆盖它。
# 加载/校验实现见 openagents/utils/agent_config.py。
# ============================================================================

version: 1

# 交付流：standard(默认) / minimal(紧凑 Spec→一次实现→原 issue 验收) /
# generate-only(紧凑 Spec→受约束 executor→机械合并，无质量验证) /
# v0.2(批量 Spec→post-Spec DAG→一次 Developer→Acceptance→机械合并)。
# minimal 是显式实验 profile；省略此键时存量行为完全不变。
# flow: minimal

# Vigil 准入协调 (Spec-0091)：dependencies(默认，Curator 排硬依赖) /
# soft(90 秒内生成非阻塞建议，软排序；原始 issue/验收保持权威) /
# off(不调用协调模型、不自动落边；既有 forge 依赖照常生效)。
# coordination: soft

# 托管平台(forge)选择(Spec-0074)：github(gh CLI，默认) / gitea(REST，token 从环境变量读)。
# 缺省整段可省 = github，存量用户零感知。gitea 时必须带同级 gitea 连接段：
# forge: gitea
# gitea:
#   base_url: http://localhost:3000
#   owner: your-org
#   repo: your-repo
#   token_env: GITEA_TOKEN   # 可省，默认 GITEA_TOKEN；OpenAgents 不存 token 本体

# 每个角色接哪个后端(同项目可混接 Claude Code / Codex / nexau)。
# 缺省角色回落 claude_code。v0.2 仅使用 spec_writer / spec_curator / developer / acceptance。
agents:
  architect:   { backend: claude_code }
  spec_writer: { backend: claude_code }
  spec_curator: { backend: claude_code }
  implementer: { backend: claude_code }
  developer:   { backend: claude_code }
  acceptance:  { backend: claude_code }
  executor:    { backend: claude_code }
  reviewer:    { backend: claude_code }

# 每个可配阶段归谁把关：
#   agent  自动化把关(红了自动打回 implementer)
#   skip   不设此闸(当 PASS 放行)
# 注意每闸合法取值不同(见右侧注释)——conflict/merge 恒由 agent 执行、不可 skip。
stages:
  triage:   agent      # 准入门控        取值: agent / skip
  rfc:      agent      # RFC 起草        取值: agent / skip (skip 会告警——撞理念4「先改 RFC 再改代码」)
  architecture: agent  # 实现前架构评审 取值: agent / skip (skip 仅与 rfc:skip 配套)
  conflict: agent      # 解冲突          取值: agent (不可 skip)
  ci:       agent      # 等 CI 全绿      取值: agent / skip
  e2e:      agent      # 端到端取证      取值: agent / skip
  review:   agent      # 代码评审        取值: agent / skip
  merge:    agent      # 合并            取值: agent (不可 skip)

# 顶层发版策略：manual(人决定何时发版，默认最安全) / auto。
release: manual

# 单仓库默认(多仓时被每仓 override 覆盖)。
defaults:
  interval: 60         # 守夜轮询间隔(秒)
  base: main           # 目标分支
  labels: [openagents] # issue 发现标签

# 多仓库统管：每仓一子进程隔离(gh/git 绑进程 cwd)。单仓时整段可省(默认守当前目录 path=.)。
repos:
  - path: .
    # 可选每仓覆盖：name / base / interval / labels / stages(三级合并)
    # stages:
    #   e2e: skip

# ── 约束(违反会直接报错) ────────────────────────────────────────────────
# 1) 不许零闸：review: skip + merge: agent 会让未审代码自动盲合进 main——报错。
#    merge 恒自动执行，因此 review 必须保持 agent。
# 2) 硬闸名进不了 stages：head-advanced / evidence-stamp / round-cap 是确定性硬闸、恒机器把关；
#    implement / deliver 恒派 agent。写进 stages 均 reject。
# 3) skip 在感知层归一：ci:skip→CI 当 success，e2e:skip→证据戳当前 head。
